generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Regra aprendida: dado o "formato" do Texto breve, em que posição está a sigla e o código.
// indiceSigla e indiceCodigo nulos = padrão marcado como "ignorar".
model RegraExtracao {
  id           String   @id @default(cuid())
  padrao       String   @unique
  indiceSigla  Int?
  indiceCodigo Int?
  exemplo      String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// Cadastro de siglas: uma linha por par (sigla, CD pai). Os pares novos entram sozinhos
// quando uma planilha de produção é carregada; os demais campos são preenchidos à mão.
model Sigla {
  id           String   @id @default(cuid())
  sigla        String
  cdPai        String
  estrutura    String   @default("")
  kva          String   @default("")
  circuito     String   @default("")
  tipo         String   @default("")
  observacao   String   @default("")
  origem       String   @default("auto")
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([sigla, cdPai])
  @@index([estrutura])
}

// Planilha Mestre: guarda só o que é digitado à mão (tempo, peso médio, rótulo, linhas manuais).
// As linhas "automáticas" são derivadas do cadastro de siglas na tela, então nunca duplicam.
model MestreLinha {
  id           String   @id @default(cuid())
  produto      String
  tensao       String   @default("")
  construtivo  String   @default("")
  rotulo       String   @default("")
  tempoH       Float?
  pesoMedio    Float?
  manual       Boolean  @default(false)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([produto, tensao, construtivo])
}

model MestreConfig {
  chave String @id
  valor String
}
