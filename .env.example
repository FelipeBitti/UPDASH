# Neon -> Dashboard > Connect. Use a string "pooled" (com -pooler no host) para a app...
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# ...e a string "direct" (sem -pooler) para o prisma db push
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.REGIAO.aws.neon.tech/neondb?sslmode=require"

# Opcional: protege o site inteiro com usuário/senha (se vazio, fica aberto)
BASIC_AUTH_USER=""
BASIC_AUTH_PASS=""
